<Page x:Class="KabinetPsychologistApp.Pages.AuditListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Журнал сессий" Background="#F4F7F9"
      IsVisibleChanged="Page_IsVisibleChanged">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Журнал изменений сессий (последние 500 записей)" Style="{StaticResource PageTitle}"/>

        <DataGrid x:Name="DGMain" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Время" Binding="{Binding OperationAt, StringFormat='dd.MM.yyyy HH:mm:ss'}" Width="auto" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="Операция" Binding="{Binding Operation}" Width="100" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="ID сессии" Binding="{Binding SessionID}" Width="90" ElementStyle="{StaticResource CellText}"/>
                <DataGridCheckBoxColumn Header="Было оплачено" Binding="{Binding OldPaymentStatus, Mode=OneWay}" Width="SizeToHeader"/>
                <DataGridCheckBoxColumn Header="Стало оплачено" Binding="{Binding NewPaymentStatus, Mode=OneWay}" Width="SizeToHeader" />
                <DataGridTextColumn Header="Было (дата сессии)" Binding="{Binding OldSessionDateTime, StringFormat='dd.MM.yyyy HH:mm'}" Width="SizeToHeader" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="Стало (дата сессии)" Binding="{Binding NewSessionDateTime, StringFormat='dd.MM.yyyy HH:mm'}" Width="SizeToHeader" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="Пользователь" Binding="{Binding User}" Width="*" ElementStyle="{StaticResource CellText}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
